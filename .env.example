# Public, instance-specific configuration
TREN_SHEET_ID=your-google-spreadsheet-id
TREN_DASHBOARD_USER=tren

# Secrets: generate unique values and never commit the completed file.
TREN_TELEGRAM_TOKEN=123456789:replace-with-your-bot-token
TREN_WEBHOOK_SECRET=replace-with-a-long-random-value
TREN_DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Paste the service-account JSON as one environment-variable value in Railway.
TREN_GOOGLE_CREDENTIALS_JSON={"type":"service_account","replace":"with the complete JSON document"}

# Railway supplies PORT and RAILWAY_PUBLIC_DOMAIN automatically.
# Other providers should set PORT and TREN_PUBLIC_URL=https://tren.example.com.
